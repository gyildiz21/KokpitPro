{
  "name": "kokpit-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Faz-farkındalı geliştirme kokpiti — faz belgelerinden okuyan, kod durumunu haritada gösteren araç",
  "scripts": {
    "dev": "tsx watch kokpit/server.ts",
    "start": "tsx kokpit/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync:preview": "node scripts/sync-preview.mjs",
    "check:preview": "node scripts/sync-preview.mjs --check",
    "kokpit": "tsx kokpit/cli.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
