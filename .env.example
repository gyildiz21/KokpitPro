# KokpitPro local server
PORT=4173
HOST=127.0.0.1

# Cloud staging (Railway): all values are required unless marked optional.
# KOKPIT_DEPLOYMENT_MODE=cloud
# HOST=0.0.0.0
# KOKPIT_PUBLIC_ORIGIN=https://your-service.up.railway.app
# KOKPIT_TRUSTED_HOSTS=optional-extra-host.example
# KOKPIT_ACCESS_USERNAME=kokpit
# KOKPIT_ACCESS_PASSWORD=use-at-least-24-random-characters
# KOKPIT_DATA_DIR=/data

# Recommended for private repositories: GitHub App with Contents: read.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=C:\secure\kokpit-pro.pem
# Cloud secret alternative; literal newlines or escaped \\n are accepted.
# GITHUB_APP_PRIVATE_KEY=

# Local-development fallback; never expose this value to the browser.
# GITHUB_TOKEN=
